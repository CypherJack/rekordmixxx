<!--
  Jog dial: white ring + blue ring around the BPM readout. Like rekordbox, the ring is a
  round tempo fader: drag to change tempo, right click to reset; the red arc shows the offset.
  The +-N label below cycles the tempo range.
  Layout-less group: children use <Pos>.
  Variables: ChanNum
-->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>JogDial</ObjectName>
    <Size>112f,112f</Size>
    <BackPath scalemode="STRETCH_ASPECT">skin:images/jog_bg.svg</BackPath>
    <Children>
      <!-- BPM / tempo readout drawn on the static ring -->
      <NumberBpm>
        <ObjectName>JogBpm</ObjectName>
        <TooltipId>visual_bpm</TooltipId>
        <Pos>21,38</Pos>
        <Size>70f,22f</Size>
        <Channel><Variable name="ChanNum"/></Channel>
        <NumberOfDigits>1</NumberOfDigits>
        <Alignment>center</Alignment>
        <Connection>
          <ConfigKey><Variable name="Group"/>,visual_bpm</ConfigKey>
        </Connection>
      </NumberBpm>
      <NumberRate>
        <ObjectName>JogRate</ObjectName>
        <TooltipId>rate_display</TooltipId>
        <Pos>21,60</Pos>
        <Size>70f,14f</Size>
        <Channel><Variable name="ChanNum"/></Channel>
        <NumberOfDigits>1</NumberOfDigits>
        <Alignment>center</Alignment>
      </NumberRate>
      <!-- The ring is a round tempo fader. Drag to change tempo,
           right-click to reset; the arc on the blue ring shows the offset. -->
      <WidgetGroup>
        <ObjectName>JogTempoRing</ObjectName>
        <Pos>0,0</Pos>
        <Size>112f,112f</Size>
        <Children>
          <KnobComposed>
            <ObjectName>JogTempoKnob</ObjectName>
            <TooltipId>rate</TooltipId>
            <Pos>0,0</Pos>
            <Size>112f,112f</Size>
            <MinAngle>-150</MinAngle>
            <MaxAngle>150</MaxAngle>
            <ArcRadius>41</ArcRadius>
            <ArcThickness>3</ArcThickness>
            <ArcColor>#e03c3c</ArcColor>
            <ArcUnipolar>false</ArcUnipolar>
            <ArcRoundCaps>true</ArcRoundCaps>
            <!-- clockwise = faster (with the default rate_dir, positive rate is slower):
                 mirror the 0..1 parameter as 1 - p -->
            <Connection>
              <ConfigKey><Variable name="Group"/>,rate</ConfigKey>
              <Transform><Invert/><Add>1</Add></Transform>
            </Connection>
          </KnobComposed>
          <!-- cycles 6, 8, 10, 16, 24, 50 %; a second button per 6/10/24 matches the value a
               CPU without fused multiply-add lands on when writing that parameter -->
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.007518796992481203</SetVariable>
            <SetVariable name="Next">0.012531328320802004</SetVariable>
            <SetVariable name="Text">&#xB1;4</SetVariable>
          </Template>
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.012531328320802003</SetVariable>
            <SetVariable name="Next">0.017543859649122806</SetVariable>
            <SetVariable name="Text">&#xB1;6</SetVariable>
          </Template>
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.012531328320802004</SetVariable>
            <SetVariable name="Next">0.017543859649122806</SetVariable>
            <SetVariable name="Text">&#xB1;6</SetVariable>
          </Template>
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.017543859649122806</SetVariable>
            <SetVariable name="Next">0.022556390977443608</SetVariable>
            <SetVariable name="Text">&#xB1;8</SetVariable>
          </Template>
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.02255639097744361</SetVariable>
            <SetVariable name="Next">0.03759398496240601</SetVariable>
            <SetVariable name="Text">&#xB1;10</SetVariable>
          </Template>
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.022556390977443608</SetVariable>
            <SetVariable name="Next">0.03759398496240601</SetVariable>
            <SetVariable name="Text">&#xB1;10</SetVariable>
          </Template>
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.03759398496240601</SetVariable>
            <SetVariable name="Next">0.05764411027568922</SetVariable>
            <SetVariable name="Text">&#xB1;16</SetVariable>
          </Template>
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.05764411027568921</SetVariable>
            <SetVariable name="Next">0.12280701754385964</SetVariable>
            <SetVariable name="Text">&#xB1;24</SetVariable>
          </Template>
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.05764411027568922</SetVariable>
            <SetVariable name="Next">0.12280701754385964</SetVariable>
            <SetVariable name="Text">&#xB1;24</SetVariable>
          </Template>
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.12280701754385964</SetVariable>
            <SetVariable name="Next">0.012531328320802004</SetVariable>
            <SetVariable name="Text">&#xB1;50</SetVariable>
          </Template>
          <Template src="skin:templates/controls/tempo_range_button.xml">
            <SetVariable name="Value">0.22305764411027568</SetVariable>
            <SetVariable name="Next">0.012531328320802004</SetVariable>
            <SetVariable name="Text">&#xB1;90</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
