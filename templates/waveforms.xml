<!-- Enlarged waveform panel: stacked waveforms (3/4 in 4-deck mode) + zoom strip. -->
<Template>
  <WidgetGroup>
    <ObjectName>Waveforms</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>
      <WidgetGroup>
        <ObjectName>WaveformRows</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,me</SizePolicy>
        <Children>
          <Template src="skin:templates/waveform.xml"><SetVariable name="ChanNum">1</SetVariable></Template>
          <Template src="skin:templates/waveform.xml"><SetVariable name="ChanNum">2</SetVariable></Template>
          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <Template src="skin:templates/waveform.xml"><SetVariable name="ChanNum">3</SetVariable></Template>
              <Template src="skin:templates/waveform.xml"><SetVariable name="ChanNum">4</SetVariable></Template>
            </Children>
            <Connection>
              <ConfigKey persist="true">[Skin],show_4decks</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>ZoomStrip</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>f,me</SizePolicy>
        <MinimumSize>26,-1</MinimumSize>
        <MaximumSize>26,-1</MaximumSize>
        <Children>
          <WidgetGroup><Size>1me,1me</Size></WidgetGroup>
          <Template src="skin:templates/controls/button.xml">
            <SetVariable name="ObjectName">ZoomButton</SetVariable>
            <SetVariable name="TooltipId">waveform_zoom_down</SetVariable>
            <SetVariable name="Size">22f,20f</SetVariable>
            <SetVariable name="Text">+</SetVariable>
            <SetVariable name="LeftPush">true</SetVariable>
            <SetVariable name="ConfigKey">[Channel1],waveform_zoom_down</SetVariable>
          </Template>
          <Template src="skin:templates/controls/button.xml">
            <SetVariable name="ObjectName">ZoomButton</SetVariable>
            <SetVariable name="TooltipId">waveform_zoom_set_default</SetVariable>
            <SetVariable name="Size">22f,20f</SetVariable>
            <SetVariable name="Text">RST</SetVariable>
            <SetVariable name="LeftPush">true</SetVariable>
            <SetVariable name="ConfigKey">[Channel1],waveform_zoom_set_default</SetVariable>
          </Template>
          <Template src="skin:templates/controls/button.xml">
            <SetVariable name="ObjectName">ZoomButton</SetVariable>
            <SetVariable name="TooltipId">waveform_zoom_up</SetVariable>
            <SetVariable name="Size">22f,20f</SetVariable>
            <SetVariable name="Text">&#x2212;</SetVariable>
            <SetVariable name="LeftPush">true</SetVariable>
            <SetVariable name="ConfigKey">[Channel1],waveform_zoom_up</SetVariable>
          </Template>
          <WidgetGroup><Size>1me,1me</Size></WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
