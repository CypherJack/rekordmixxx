<!-- Slim tempo fader. Variables: ChanNum -->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>RateColumn</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>f,f</SizePolicy>
    <MinimumSize>22,112</MinimumSize>
    <MaximumSize>22,112</MaximumSize>
    <Children>
      <Template src="skin:templates/controls/fader.xml">
        <SetVariable name="ObjectName">RateFader</SetVariable>
        <SetVariable name="TooltipId">rate</SetVariable>
        <SetVariable name="Size">22f,112f</SetVariable>
        <SetVariable name="BarAxisPos">11</SetVariable>
        <SetVariable name="Horizontal">false</SetVariable>
        <SetVariable name="Unipolar">false</SetVariable>
        <SetVariable name="Track">fader_track_v.svg</SetVariable>
        <SetVariable name="Handle">fader_handle_v.svg</SetVariable>
        <SetVariable name="ConfigKey"><Variable name="Group"/>,rate</SetVariable>
      </Template>
    </Children>
  </WidgetGroup>
</Template>
