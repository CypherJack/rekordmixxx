<!--
  Right-hand player panel (decks 2 and 4): mirror image of deck_left.xml.  Variables: ChanNum
-->
<Template>
  <WidgetGroup>
    <ObjectName>Deck</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,f</SizePolicy>
    <Children>
      <Template src="skin:templates/deck_header.xml"/>
      <Template src="skin:templates/deck_overview.xml"/>
      <WidgetGroup>
        <ObjectName>DeckControls</ObjectName>
        <Layout>horizontal</Layout>
        <SizePolicy>me,f</SizePolicy>
        <Children>
          <Template src="skin:templates/rate_slider.xml"/>
          <Template src="skin:templates/transport.xml"/>
          <Template src="skin:templates/jog.xml"/>
          <Template src="skin:templates/slip_block.xml"/>
          <Template src="skin:templates/loop_block.xml"/>
          <Template src="skin:templates/pads.xml"/>
        </Children>
      </WidgetGroup>
      <Template src="skin:templates/deck_footer.xml"/>
    </Children>
  </WidgetGroup>
</Template>
