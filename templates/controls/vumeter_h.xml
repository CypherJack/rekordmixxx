<!-- Thin horizontal level meter. Variables: Group ([Main]), Suffix (_left|_right), TooltipId -->
<Template>
  <VuMeter>
    <TooltipId><Variable name="TooltipId"/></TooltipId>
    <Size>72f,4f</Size>
    <PathBack scalemode="STRETCH">skin:images/hvu_bg.svg</PathBack>
    <PathVu scalemode="STRETCH">skin:images/hvu_on.svg</PathVu>
    <Horizontal>true</Horizontal>
    <PeakHoldSize>2</PeakHoldSize>
    <PeakHoldTime>500</PeakHoldTime>
    <PeakFallTime>50</PeakFallTime>
    <PeakFallStep>2</PeakFallStep>
    <Connection>
      <ConfigKey><Variable name="Group"/>,vu_meter<Variable name="Suffix"/></ConfigKey>
    </Connection>
  </VuMeter>
</Template>
