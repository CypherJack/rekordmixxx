<!-- REV + CUE (orange ring) + PLAY (green ring). Variables: ChanNum -->
<Template>
  <SetVariable name="Group">[Channel<Variable name="ChanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>Transport</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>f,f</SizePolicy>
    <MinimumSize>44,-1</MinimumSize>
    <MaximumSize>44,-1</MaximumSize>
    <Children>
      <Template src="skin:templates/controls/button.xml">
        <SetVariable name="ObjectName">ReverseButton</SetVariable>
        <SetVariable name="TooltipId">reverse</SetVariable>
        <SetVariable name="Size">44f,22f</SetVariable>
        <SetVariable name="Text">REV</SetVariable>
        <SetVariable name="LeftPush">false</SetVariable>
        <SetVariable name="ConfigKey"><Variable name="Group"/>,reverse</SetVariable>
      </Template>
      <WidgetGroup><Size>1min,1me</Size></WidgetGroup>
      <PushButton>
        <ObjectName>CueButton</ObjectName>
        <TooltipId>cue_default_cue_gotoandstop</TooltipId>
        <Size>38f,38f</Size>
        <NumberStates>2</NumberStates>
        <LeftClickIsPushButton>true</LeftClickIsPushButton>
        <RightClickIsPushButton>true</RightClickIsPushButton>
        <State><Number>0</Number><Text>CUE</Text></State>
        <State><Number>1</Number><Text>CUE</Text></State>
        <Connection>
          <ConfigKey><Variable name="Group"/>,cue_default</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
          <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
          <ConnectValueToWidget>false</ConnectValueToWidget>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="Group"/>,cue_gotoandstop</ConfigKey>
          <ButtonState>RightButton</ButtonState>
          <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
          <ConnectValueToWidget>false</ConnectValueToWidget>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="Group"/>,cue_indicator</ConfigKey>
          <ConnectValueFromWidget>false</ConnectValueFromWidget>
        </Connection>
      </PushButton>
      <WidgetGroup><Size>1min,6f</Size></WidgetGroup>
      <PushButton>
        <ObjectName>PlayButton</ObjectName>
        <TooltipId>play_cue_set</TooltipId>
        <Size>38f,38f</Size>
        <NumberStates>2</NumberStates>
        <State><Number>0</Number></State>
        <State><Number>1</Number></State>
        <Connection>
          <ConfigKey><Variable name="Group"/>,play</ConfigKey>
          <ButtonState>LeftButton</ButtonState>
          <ConnectValueToWidget>false</ConnectValueToWidget>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="Group"/>,cue_set</ConfigKey>
          <ButtonState>RightButton</ButtonState>
          <EmitOnDownPress>true</EmitOnDownPress>
          <ConnectValueToWidget>false</ConnectValueToWidget>
        </Connection>
        <Connection>
          <ConfigKey><Variable name="Group"/>,play_indicator</ConfigKey>
          <ConnectValueFromWidget>false</ConnectValueFromWidget>
        </Connection>
      </PushButton>
    </Children>
  </WidgetGroup>
</Template>
